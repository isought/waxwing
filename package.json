{
  "name": "@isought/waxwing",
  "version": "0.3.0",
  "type": "module",
  "description": "Inspectable architecture diagrams for humans and coding agents.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "validate": "node scripts/validate-model.mjs",
    "test": "node --test",
    "demo": "node bin/waxwing.mjs build examples/subgraphs/model.json examples/subgraphs/generated",
    "demo:basic": "node bin/waxwing.mjs build examples/order-processing/model.json examples/order-processing/generated --group system-structure",
    "demo:documents": "node bin/waxwing.mjs build examples/documented-orders/model.json examples/documented-orders/generated --group system-structure",
    "demo:subgraphs": "node bin/waxwing.mjs build examples/subgraphs/model.json examples/subgraphs/generated",
    "demo:sequence": "node bin/waxwing.mjs build examples/sequence/model.json examples/sequence/generated",
    "demo:sequence:markets": "node bin/waxwing.mjs build examples/sequence-markets/model.json examples/sequence-markets/generated",
    "demo:workflow": "node bin/waxwing.mjs build examples/orchestration/model.json examples/orchestration/generated",
    "demo:site": "node bin/waxwing.mjs build-site examples/multi-page/model.json examples/multi-page/generated",
    "demo:self": "node bin/waxwing.mjs build-site examples/waxwing/model.json examples/waxwing/generated --direction DOWN",
    "test:package": "node scripts/smoke-package.mjs",
    "demo:connected": "node experiments/connected-source/demo.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "elkjs": "0.12.0",
    "markdown-it": "15.0.1",
    "tree-sitter-wasm": "2.0.1",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.27.0"
  },
  "exports": {
    "./model": "./modules/model/index.mjs",
    "./layout": "./modules/layout/index.mjs",
    "./render": "./modules/render/index.mjs",
    "./artifacts": "./modules/render/artifacts.mjs",
    "./documents": "./modules/documents/index.mjs",
    "./graphs": "./modules/graphs/index.mjs",
    "./sequence": "./modules/sequence/index.mjs",
    "./workflow": "./modules/workflow/index.mjs",
    "./site": "./modules/site/index.mjs",
    "./collection": "./modules/site/collection.mjs",
    "./query": "./modules/query/index.mjs",
    "./skill": "./modules/skill/index.mjs",
    "./workspace": "./modules/workspace/index.mjs",
    "./analysis": "./modules/analysis/index.mjs",
    "./source": "./modules/knowledge/source/index.mjs",
    "./scan": "./modules/application/scan.mjs",
    "./source-view": "./modules/presentation/source/index.mjs",
    "./connected": "./modules/application/connected.mjs",
    "./source-links": "./modules/knowledge/source-links/index.mjs"
  },
  "bin": {
    "waxwing": "./bin/waxwing.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isought/waxwing.git"
  },
  "homepage": "https://github.com/isought/waxwing#readme",
  "bugs": {
    "url": "https://github.com/isought/waxwing/issues"
  },
  "keywords": [
    "architecture",
    "diagrams",
    "documentation",
    "agents",
    "svg"
  ],
  "files": [
    "bin/",
    "modules/",
    "skills/",
    "schemas/",
    "lib/",
    "AGENT_GUIDE.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/",
    "examples/**/*.json",
    "examples/**/*.md",
    "!examples/**/generated/**"
  ],
  "publishConfig": {
    "access": "public"
  }
}
