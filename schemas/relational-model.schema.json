{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waxwing.dev/schemas/relational-model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "diagramType": {
      "const": "relational"
    },
    "schemaVersion": {
      "const": "relational-1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "timeframe": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "environment",
        "timeframe",
        "coverage",
        "question"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "locator",
          "description"
        ]
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/index"
      }
    },
    "associations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/association"
      }
    }
  },
  "required": [
    "diagramType",
    "schemaVersion",
    "id",
    "title",
    "scope",
    "sources",
    "tables",
    "columns",
    "constraints",
    "indexes",
    "associations"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "established",
            "reported",
            "inferred",
            "unknown"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "sourceRefs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "inferred",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {}
            }
          }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "table",
            "view",
            "materializedView"
          ]
        },
        "external": {
          "type": "boolean"
        },
        "architectureRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "recordId": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "modelId",
              "recordId",
              "label"
            ]
          }
        }
      },
      "required": [
        "id",
        "label",
        "evidence",
        "name",
        "schema",
        "kind",
        "external"
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tableRef": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dataType": {
          "type": [
            "string",
            "null"
          ]
        },
        "nullable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "ordinal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "generated": {
          "enum": [
            null,
            "stored",
            "virtual"
          ]
        },
        "generationExpression": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "enum": [
            null,
            "always",
            "byDefault"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "evidence",
        "tableRef",
        "name",
        "dataType",
        "nullable",
        "default",
        "ordinal"
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tableRef": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "primary",
            "unique",
            "foreign",
            "check"
          ]
        },
        "columnRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tableRef": {
              "type": "string",
              "minLength": 1
            },
            "columnRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "tableRef",
            "columnRefs"
          ]
        },
        "onDelete": {
          "enum": [
            "no action",
            "restrict",
            "cascade",
            "set null",
            "set default",
            null
          ]
        },
        "onUpdate": {
          "enum": [
            "no action",
            "restrict",
            "cascade",
            "set null",
            "set default",
            null
          ]
        },
        "match": {
          "enum": [
            "simple",
            "full",
            "partial",
            null
          ]
        },
        "validated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "deferrable": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "evidence",
        "tableRef",
        "kind",
        "columnRefs",
        "definition"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "foreign"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "references",
              "onDelete",
              "onUpdate",
              "match",
              "validated",
              "deferrable"
            ],
            "properties": {
              "references": {},
              "onDelete": {},
              "onUpdate": {},
              "match": {},
              "validated": {},
              "deferrable": {}
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "references"
                  ],
                  "properties": {
                    "references": {}
                  }
                },
                {
                  "required": [
                    "onDelete"
                  ],
                  "properties": {
                    "onDelete": {}
                  }
                },
                {
                  "required": [
                    "onUpdate"
                  ],
                  "properties": {
                    "onUpdate": {}
                  }
                },
                {
                  "required": [
                    "match"
                  ],
                  "properties": {
                    "match": {}
                  }
                },
                {
                  "required": [
                    "validated"
                  ],
                  "properties": {
                    "validated": {}
                  }
                },
                {
                  "required": [
                    "deferrable"
                  ],
                  "properties": {
                    "deferrable": {}
                  }
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "primary",
                  "unique",
                  "foreign"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "columnRefs": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tableRef": {
          "type": "string",
          "minLength": 1
        },
        "unique": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "columnRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "predicate": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ready": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "evidence",
        "tableRef",
        "unique",
        "columnRefs",
        "expression",
        "predicate",
        "method"
      ]
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tableRef": {
              "type": "string",
              "minLength": 1
            },
            "columnRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "tableRef",
            "columnRefs"
          ]
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tableRef": {
              "type": "string",
              "minLength": 1
            },
            "columnRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "tableRef",
            "columnRefs"
          ]
        },
        "enforcement": {
          "enum": [
            "application",
            "inferred"
          ]
        },
        "cardinality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "enum": [
                    0,
                    1,
                    null
                  ]
                },
                "max": {
                  "enum": [
                    1,
                    "many",
                    null
                  ]
                }
              },
              "required": [
                "min",
                "max"
              ]
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "enum": [
                    0,
                    1,
                    null
                  ]
                },
                "max": {
                  "enum": [
                    1,
                    "many",
                    null
                  ]
                }
              },
              "required": [
                "min",
                "max"
              ]
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "evidence",
        "from",
        "to",
        "enforcement",
        "cardinality"
      ]
    }
  }
}
